# BauPilot — Umgebungsvariablen-Vorlage.
# Secrets gehören ausschließlich in die .env am Server bzw. ins
# Deploy-Tool (Forge/Ploi), nie ins Repository (Architekturblatt
# Abschnitt 10). Diese Datei dokumentiert nur, WAS zu setzen ist.

APP_NAME=BauPilot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Die App speichert in UTC und rechnet fachlich (Fristen, Digest,
# Scheduler) in Europe/Vienna — APP_TIMEZONE bleibt UTC.
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_AT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL laut Architekturblatt Abschnitt 4. Für einen schnellen
# lokalen Start funktioniert auch DB_CONNECTION=sqlite (ohne die
# weiteren DB_*-Zeilen) — pg_trgm-Dublettensuche läuft dann im
# PHP-Fallback.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=baupilot
DB_USERNAME=baupilot
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# --- Belegablage (Abschnitt 6) ---------------------------------------
# Lokal: DOCUMENTS_DRIVER=local (Dateien unter storage/app/documents).
# Staging/Produktion: DOCUMENTS_DRIVER=s3 mit Hetzner Object Storage
# (S3-kompatibel, Path-Style). Je Umgebung ein eigener Bucket.
DOCUMENTS_DRIVER=local
DOCUMENTS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central
AWS_BUCKET=
# Hetzner-Beispiel: https://fsn1.your-objectstorage.com
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- E-Mail (Abschnitte 7 und 12) ------------------------------------
# Produktion: transaktionaler Versand über Brevo oder Mailjet (EU),
# Zugangsdaten aus dem jeweiligen SMTP-Bereich. Lokal: log.
# Brevo:   MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587
# Mailjet: MAIL_HOST=in-v3.mailjet.com,    MAIL_PORT=587
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="office@example.at"
MAIL_FROM_NAME="${APP_NAME}"

# --- Web-Push (Abschnitt 7, Ausbau in M6) ----------------------------
# VAPID-Schlüsselpaar einmal erzeugen (z. B. npx web-push
# generate-vapid-keys) und sicher verwahren; der private Schlüssel
# verlässt den Server nie. Die Tabellen (push_subscriptions,
# Einstellungen) existieren bereits, der Versand folgt in M6.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:office@example.at"

# --- KI-Rechnungsscan (Eingangsrechnungen) ---------------------------
# Anthropic-API-Schlüssel (console.anthropic.com). Ohne Schlüssel bleibt
# der Scan-Knopf ausgeblendet — manuelle Erfassung funktioniert immer.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# --- Betriebsüberwachung (Abschnitt 10) ------------------------------
# GET /up            → einfacher Uptime-Ping
# GET /up/details    → Platte, Queue-Rückstau, Scheduler-Heartbeat
# In Produktion Token setzen; der externe Uptime-Check ruft dann
# /up/details?token=… auf. Schwellwerte optional übersteuerbar.
HEALTH_CHECK_TOKEN=
# HEALTH_DISK_WARN_PERCENT=90
# HEALTH_QUEUE_MAX_AGE_MINUTES=15
# HEALTH_SCHEDULER_MAX_AGE_MINUTES=10

VITE_APP_NAME="${APP_NAME}"
